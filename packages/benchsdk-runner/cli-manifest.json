      "flags": [
        "--tagline",
        "--description",
        "--description-file",
        "--clear-tagline",
        "--clear-description"
      ],
      "summary": "Set or clear a benchmark's tagline and description",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "mute"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [],
      "summary": "Mute a benchmark for the organization (hides it from the org's run feed)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "unmute"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [],
      "summary": "Unmute a benchmark for the organization",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "pause"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--start",
        "--end"
