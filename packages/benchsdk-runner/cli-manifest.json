      "flags": [
        "--limit",
        "--offset",
        "--participant",
        "--since",
        "--until",
        "--day",
        "--tz",
        "--source-org",
        "--archived",
        "--include-muted",
        "--benchmark"
      ],
      "summary": "List benchmark runs (omit the slug to list runs across every benchmark you can read)",
      "since": "0.2.0",
      "flagsSince": {
        "--participant": "0.8.0",
        "--since": "0.8.0",
        "--until": "0.8.0",
        "--day": "0.8.0",
        "--tz": "0.8.0",
        "--source-org": "0.8.0",
        "--archived": "0.9.5",
        "--include-muted": "0.9.5",
        "--benchmark": "0.9.5"
      },
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "feed"
      ],
      "args": [],
      "flags": [
        "--benchmark",
        "--include-archived",
        "--include-muted",
        "--limit"
      ],
      "summary": "The organization's newest runs across benchmarks, with stats (the dashboard feed)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "days"
      ],
      "args": [],
      "flags": [
        "--benchmark",
        "--include-archived",
        "--include-muted",
        "--tz"
      ],
      "summary": "Run counts per local day across benchmarks",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "day"
      ],
      "args": [
        "<day>"
      ],
      "flags": [
        "--benchmark",
        "--include-archived",
        "--include-muted",
        "--tz",
        "--all",
        "--cursor"
      ],
      "summary": "Runs of one local day across benchmarks (--all follows every page)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "show"
