      "flags": [],
      "summary": "Restore an archived benchmark and its runs",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "describe"
      ],
      "args": [
        "<benchmark-slug>"
