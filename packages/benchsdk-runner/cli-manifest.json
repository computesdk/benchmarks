{
  "schemaVersion": 1,
  "bin": "bench",
  "package": "@benchsdk/runner",
  "version": "0.8.4",
  "source": {
    "repo": "computesdk/benchmarks",
    "released": false
  },
  "cli": {
    "package": "@benchsdk/cli",
    "version": "0.9.4"
  },
  "globalFlags": [
    "--base-url",
    "--api-key",
    "--org",
    "--format",
    "--json",
    "--verbose",
    "--version",
    "--help"
  ],
  "commands": [
    {
      "path": [
        "run"
      ],
      "args": [
        "<file.bench.ts>"
      ],
      "flags": [
        "--shape",
        "--provider",
        "--run-key",
        "--benchmark",
        "--slug",
        "--name",
        "--iterations",
        "--concurrency",
        "--stagger-delay-ms",
        "--group-by",
        "--deadline-ms",
        "--scheduled-for",
        "--no-ingest",
        "--dry-run",
        "--check",
        "--validate",
        "--base-url",
        "--api-key"
      ],
      "summary": "Execute a benchmark file",
      "since": "0.2.0",
      "flagsSince": {
        "--no-ingest": "0.3.0",
        "--dry-run": "0.3.0",
        "--check": "0.5.0",
        "--validate": "0.5.0",
        "--deadline-ms": "0.6.3",
        "--scheduled-for": "0.8.0"
      },
      "package": "@benchsdk/runner"
    },
    {
      "path": [
        "check"
      ],
      "args": [
        "<file.bench.ts>"
      ],
      "flags": [
        "--base-url",
        "--api-key",
        "--shape",
        "--provider",
        "--no-ingest",
        "--dry-run"
      ],
      "summary": "Validate config, auth, participants and scoring for a benchmark file without running it",
      "since": "0.5.0",
      "package": "@benchsdk/runner"
    },
    {
      "path": [
        "auth",
        "login"
      ],
      "args": [],
      "flags": [],
      "summary": "Authenticate with OAuth device flow",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "auth",
        "logout"
      ],
      "args": [],
      "flags": [],
      "summary": "Remove saved credentials",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "auth",
        "status"
      ],
      "args": [],
      "flags": [],
      "summary": "Show current user and active organization",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "org",
        "list"
      ],
      "args": [],
      "flags": [],
      "summary": "List organizations",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "org",
        "use"
      ],
      "args": [
        "<slug>"
      ],
      "flags": [],
      "summary": "Set active organization",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "list"
      ],
      "args": [],
      "flags": [
        "--limit",
        "--offset",
        "--status",
        "--sort",
        "--order",
        "--group",
        "--category",
        "--owner",
        "--q"
      ],
      "summary": "List benchmarks (--status active|archived|all; default active), sorted and filtered like the dashboard directory",
      "since": "0.2.0",
      "flagsSince": {
        "--status": "0.9.5",
        "--sort": "0.9.5",
        "--order": "0.9.5",
        "--group": "0.9.5",
        "--category": "0.9.5",
        "--owner": "0.9.5",
        "--q": "0.9.5"
      },
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "archive"
      ],
      "args": [
        "<benchmark-slug>"
