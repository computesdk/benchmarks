      "flags": [
        "--yes"
      ],
      "summary": "Archive a benchmark and all of its runs (asks first; -y to skip)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "restore"
      ],
      "args": [
        "<benchmark-slug>"
