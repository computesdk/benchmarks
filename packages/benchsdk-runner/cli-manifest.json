      "path": [
        "runs",
        "run-again-status"
      ],
      "args": [
        "<benchmark-slug>",
        "<runAgainId>"
      ],
      "flags": [],
      "summary": "Show run-again progress: the run it reported, or null while pending",
      "since": "0.9.3",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "archive"
      ],
      "args": [
        "<runId...>"
      ],
      "flags": [
        "--yes"
      ],
      "summary": "Archive up to 100 runs (asks first; -y to skip)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "unarchive"
      ],
      "args": [
        "<runId...>"
      ],
      "flags": [
        "--yes"
      ],
      "summary": "Unarchive up to 100 runs (asks first; -y to skip)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "results"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--run",
        "--participant",
        "--steps",
        "--since",
        "--until",
        "--day",
        "--tz",
        "--source-org",
        "--limit",
        "--offset",
        "--timeline",
        "--bucket-ms",
        "--tasks",
        "--bucket-size",
        "--failure-limit"
      ],
      "summary": "Show benchmark or run results (--run --timeline: event rate and concurrency; --run --tasks: per-task buckets)",
