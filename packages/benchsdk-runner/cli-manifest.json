      "flagsSince": {
        "--timeline": "0.9.5",
        "--bucket-ms": "0.9.5",
        "--tasks": "0.9.5",
        "--bucket-size": "0.9.5",
        "--failure-limit": "0.9.5",
        "--participant": "0.8.0",
        "--steps": "0.8.0",
        "--since": "0.8.0",
        "--until": "0.8.0",
        "--day": "0.8.0",
        "--tz": "0.8.0",
        "--source-org": "0.8.0",
        "--limit": "0.8.0",
        "--offset": "0.8.0"
      },
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "matrix"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--source-org"
      ],
      "summary": "A matrix index benchmark's newest dataset",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "model-index"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--source-org"
      ],
      "summary": "A model index benchmark's newest results",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "reliability"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--day",
        "--participant",
        "--from",
        "--to",
        "--bucket",
        "--tz",
        "--metrics",
        "--breakdown",
        "--source-org"
      ],
      "summary": "Reliability uptime view for a type=reliability benchmark, or one participant on one day with --day --participant",
      "since": "0.9.2",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "reliability",
        "cards"
      ],
      "args": [],
      "flags": [
        "--include-muted"
      ],
      "summary": "The organization's reliability cards: uptime, last status and pause state per reliability benchmark",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "activity"
      ],
      "args": [],
      "flags": [
        "--days",
        "--benchmark"
      ],
      "summary": "Run counts per day for the organization or one benchmark (--days 1..90)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "run-again"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--wait",
        "--timeout",
        "--interval"
      ],
      "summary": "Run a daily benchmark again, once per organization and UTC day (needs a user login; --wait polls until the run starts)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "run-again",
        "status"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--request"
      ],
      "summary": "Today's Run again availability and quota, or one request with --request <runAgainId>",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "iterations"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--run",
        "--participant",
        "--steps",
        "--type"
      ],
      "summary": "Show per-iteration latencies (--type steps, the default, or tasks)",
      "since": "0.3.0",
      "flagsSince": {
        "--type": "0.9.5"
      },
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "workers"
      ],
      "args": [
        "<benchmark-slug>",
        "<runId>"
      ],
      "flags": [
        "--participant"
      ],
      "summary": "List a run's workers with their progress and artifacts",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "artifacts",
        "list"
      ],
      "args": [
        "<benchmark-slug>",
        "<runId>"
      ],
      "flags": [
        "--worker"
      ],
      "summary": "List run artifacts",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "artifacts",
        "download"
      ],
      "args": [
        "<benchmark-slug>",
        "<runId>",
        "<workerId>",
        "<artifactId>"
      ],
      "flags": [
        "--out"
      ],
      "summary": "Download a worker artifact's bytes to --out <file> or stdout",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "logs"
      ],
      "args": [
        "<benchmark-slug>",
        "<runId>"
      ],
      "flags": [
        "--participant",
        "--worker",
        "--max-lines"
      ],
      "summary": "Show participant worker logs (parsed, like the dashboard log view)",
      "since": "0.6.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "export"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--run",
        "--out"
      ],
      "summary": "Export benchmark or run results to JSON",
      "since": "0.2.0",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "fork"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [
        "--as",
        "--source-org",
        "--ref"
      ],
      "summary": "Fork a catalog benchmark into your org as a private benchmark that tracks the upstream bench file",
      "since": "0.9.0",
      "package": "@benchsdk/cli"
    }
  ]
}
