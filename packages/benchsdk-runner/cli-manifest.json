      "summary": "Pause a reliability benchmark (from --start, default now, until --end or resume)",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "benchmarks",
        "resume"
      ],
      "args": [
        "<benchmark-slug>"
      ],
      "flags": [],
      "summary": "Resume a paused reliability benchmark",
      "since": "0.9.5",
      "package": "@benchsdk/cli"
    },
    {
      "path": [
        "runs",
        "list"
      ],
      "args": [
        "[benchmark-slug]"
